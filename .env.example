# Copy to .env and fill in (docker compose and npm run dev read it). On Railway, set these in the service's
# Variables tab instead: BASE_URL and DATA_DIR are then found by themselves.

# Public https address of this server, without a path. Not needed on Railway or Render.
BASE_URL=https://assistant.example.com

# Google Cloud OAuth client of type "Web application" (docs/SETUP.md, part 2). The server starts without
# them, and its home page then shows what is left to set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google account(s) allowed to sign in to this server and connect Claude to it (comma-separated).
OWNER_EMAILS=you@gmail.com

# 32-byte key that encrypts the Google tokens and everything personal stored. Generate one with
# "npm run generate-secrets" or "openssl rand -base64 32". Keep a copy: without it the stored data is lost.
TOKEN_ENCRYPTION_KEY=

# Optional. Defaults shown.
# DEFAULT_TIMEZONE=UTC                # IANA zone for times given without one, the agenda and the digest, e.g. Europe/Paris
# PORT=8080
# DATA_DIR=/data                      # where the SQLite file lives; with npm run dev, use ./data
# MCP_PATH=/mcp
# SERVER_NAME=G-Spot Assistant
# PEER_UPLOAD_HOSTS=                  # host names of your other connectors (e.g. the WhatsApp connector) send_to_link may push files to
# SOURCE_URL=https://github.com/romaxnova/g-spot-assistant   # if you run a modified copy, a link to its source (AGPL)
# LOG_LEVEL=info                      # debug | info | warn | error
# TRUST_PROXY=1                       # number of proxy hops in front of the app
# DCR_ENABLED=true                    # dynamic client registration (ChatGPT uses it), next to CIMD
# CIMD_ALLOWED_HOSTS=claude.ai        # hosts whose client metadata documents are accepted
# EXTRA_REDIRECT_URIS=                # extra OAuth redirect URIs, e.g. for MCP Inspector
# ANTHROPIC_IP_LOCK=false             # true: only 160.79.104.0/21 may call the MCP endpoint (breaks Claude Code)
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=90
# TOKEN_ENCRYPTION_KEY_PREVIOUS=      # set during key rotation, then remove
